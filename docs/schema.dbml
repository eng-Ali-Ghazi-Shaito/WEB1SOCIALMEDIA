// WEB1 Social Media Platform - V1 database (PostgreSQL)

Project web1_socialmedia {
  database_type: 'PostgreSQL'
  Note: 'V1: 18 REST APIs + 7 WebSocket events. All timestamps are UTC (timestamptz).'
}

Enum code_purpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

Enum notification_type {
  FOLLOW
  LIKE
}

Table users {
  id uuid [pk]
  email varchar(254) [not null, unique, note: 'stored lowercased and trimmed']
  username varchar(30) [not null, unique, note: 'lowercase; letters, numbers, . and _']
  full_name varchar(30) [not null]
  bio varchar(150) [note: 'set in V2 (edit profile)']
  avatar_url text [note: 'null = default avatar; set in V2']
  password_hash text [not null, note: 'Argon2id, never returned']
  email_verified_at timestamptz [note: 'null = unverified, cannot log in']
  last_seen_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table auth_codes {
  id uuid [pk]
  user_id uuid [not null]
  purpose code_purpose [not null]
  code_hash text [not null, note: 'HMAC-SHA256 with a server secret']
  attempts int [not null, default: 0, note: 'max 5']
  expires_at timestamptz [not null, note: 'created_at + 10 minutes']
  used_at timestamptz [note: 'set once used; single use']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, purpose, created_at) [name: 'auth_codes_latest']
  }
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null]
  token_hash text [not null, unique, note: 'SHA-256 of the refresh token; rotated by refresh (#18)']
  user_agent varchar(255)
  expires_at timestamptz [not null]
  last_used_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table follows {
  follower_id uuid [not null, note: 'the user who follows']
  following_id uuid [not null, note: 'the user being followed']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (follower_id, following_id) [pk]
    following_id
  }
}

Table posts {
  id uuid [pk]
  author_id uuid [not null]
  image_url text [not null]
  image_key text [not null, unique, note: 'storage id, used to delete the file']
  caption varchar(2200) [note: 'null = no caption']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (author_id, created_at, id) [name: 'posts_profile_and_feed']
  }
}

Table likes {
  user_id uuid [not null]
  post_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, post_id) [pk]
    post_id
  }
}

Table conversations {
  id uuid [pk]
  user_a_id uuid [not null, note: 'the smaller of the two user ids']
  user_b_id uuid [not null, note: 'the larger of the two user ids']
  user_a_last_read_at timestamptz
  user_b_last_read_at timestamptz
  last_message_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_a_id, user_b_id) [unique, name: 'one_conversation_per_pair']
    (user_a_id, last_message_at)
    (user_b_id, last_message_at)
  }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  client_message_id uuid [not null, note: 'generated by the client; makes retries safe']
  body varchar(1000) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at, id) [name: 'messages_history']
    (sender_id, client_message_id) [unique, name: 'no_duplicate_send']
  }
}

Table notifications {
  id uuid [pk]
  recipient_id uuid [not null]
  actor_id uuid [not null]
  type notification_type [not null]
  post_id uuid [note: 'required for LIKE, null for FOLLOW']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (recipient_id, created_at, id) [name: 'notifications_list']
  }
}

Ref: auth_codes.user_id > users.id [delete: cascade]
Ref: sessions.user_id > users.id [delete: cascade]
Ref: follows.follower_id > users.id [delete: cascade]
Ref: follows.following_id > users.id [delete: cascade]
Ref: posts.author_id > users.id [delete: cascade]
Ref: likes.user_id > users.id [delete: cascade]
Ref: likes.post_id > posts.id [delete: cascade]
Ref: conversations.user_a_id > users.id [delete: cascade]
Ref: conversations.user_b_id > users.id [delete: cascade]
Ref: messages.conversation_id > conversations.id [delete: cascade]
Ref: messages.sender_id > users.id [delete: cascade]
Ref: notifications.recipient_id > users.id [delete: cascade]
Ref: notifications.actor_id > users.id [delete: cascade]
Ref: notifications.post_id > posts.id [delete: cascade]